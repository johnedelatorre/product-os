# Product OS Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control

# Atlassian API credentials
# Get API token from: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=your@email.com
ATLASSIAN_API_TOKEN=your-api-token

# Figma API token (optional, for non-MCP fallback)
# Get from: Figma > Settings > Personal Access Tokens
FIGMA_ACCESS_TOKEN=your-figma-token

# Miro API token (optional, for Miro export)
# Get from: https://miro.com/app/settings/user-profile/apps
MIRO_API_TOKEN=your-miro-token
MIRO_BOARD_ID=default-board-id
